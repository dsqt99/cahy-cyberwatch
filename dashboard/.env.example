# CAHY CyberWatch dashboard (Vite). Copy to .env, then `npm run build`.
# Every VITE_* value is baked into the built JS bundle and readable by anyone
# who opens the app, so only put keys here you accept being client-side.

# --- PostgreSQL REST API (stack/postgres-api, published on host port 5434) ---
VITE_POSTGRES_API_URL=http://localhost:5434
# Connection label shown in the UI, e.g. postgres@localhost:5435/cahy_cyberwatch
VITE_POSTGRES_DB_INFO=

# --- LLM (OpenAI-compatible endpoint) for in-dashboard AI features ---
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Serper web search ---
VITE_SERPER_API_KEY=

# --- n8n (stack, port 5678) ---
VITE_N8N_WEBHOOK_BASE=http://localhost:5678/webhook/
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat/competitions
