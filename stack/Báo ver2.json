    {
      "parameters": {
        "promptType": "define",
        "text": "=Tiêu đề: {{ $('WebpageContentExtractor').item.json.title }}\n\nNội dung: {{ $('WebpageContentExtractor').item.json.textContent }}",
        "messages": {
          "messageValues": [
            {
              "message": "=Bạn là chuyên gia phân tích bài viết. Nhiệm vụ của bạn là kiểm tra bài viết có liên quan đến tình hình an ninh trật tự tại tỉnh Hưng Yên hoặc tỉnh Thái Bình không.  \n\nNếu có hãy đánh giá nó thuộc loại nào: \"Tích cực\", \"Tiêu cực\", hoặc \"Trung lập\" về tình hình an ninh trật tự tại tỉnh Hưng Yên hoặc tỉnh Thái Bình, cũng như tóm tắt nội dung chính trong 3-5 câu.  \n\n** LƯU Ý ** Xác định chính xác, chỉ phân tích nội dung bài viết bài viết liên quan đến tình hình an ninh trật tự tỉnh Hưng Yên hoặc tỉnh Thái Bình.  \n\nTrả về kết quả theo định dạng JSON:\n{   \n  \"relevance\": true // liên quan đến tỉnh Hưng Yên hoặc tỉnh Thái Bình   \n  \"sentiment\": \"Tích cực/Tiêu cực/Trung lập\",   \n  \"summary\": \"Tóm tắt nội dung\",   \n  \"keywords\": [\"từ khóa 1\", \"từ khóa 2\", \"từ khóa 3\"] \n}  Hoặc  \n{   \n  \"relevance\": false // không liên quan đến tỉnh Hưng Yên hoặc tỉnh Thái Bình\n  \"sentiment\": \"\",   \n  \"summary\": \"\",   \n  \"keywords\": [] \n}"
            }
          ]
        },
        "batching": {}
      },
