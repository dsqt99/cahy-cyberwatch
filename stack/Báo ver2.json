        "pythonCode": "from dateutil import parser\nfrom datetime import datetime\n\ndata = []\nroot_url = _('URL Tracking').first().json.link\nkeywords = ['thaibinh', 'thai binh', 'thái bình', 'hưng yên', 'hung yen', 'hungyen']\nrow_now = datetime.now().strftime(\"%Y-%m-%d\")\n\nif 'sitemap' in root_url:\n  items = _input.first().json.urlset.url\n  for item in items:\n    title, description = '', ''\n    url = item.loc\n    try:\n      date = item.lastmod\n    except:\n      date = item['news:news']['news:publication_date']\n    if parser.parse(date).strftime(\"%Y-%m-%d\") != row_now or url.count('/') == 2:\n      continue\n    relevance = False\n    if 'news:news' in item:\n      title = item['news:news']['news:title']\n      description = item['news:news']['news:keywords']\n      for keyword in keywords:\n        if keyword in title.lower() and keyword in description.lower():\n          relevance = True\n    else:\n      relevance = True\n          \n    data.append({\n      'title': title,\n      'description': description,\n      'url': url,\n      'date': date,\n      'relevance': relevance,\n      'source_id': _('URL Tracking').first().json.id\n    })\n    \nelse:\n  items = _input.first().json.rss.channel.item\n  for item in items:\n    title = item.title\n    description = item.description\n    url = item.link\n    date = item.pubDate\n    if parser.parse(date).strftime(\"%Y-%m-%d\") != row_now or url.count('/') == 2:\n      continue\n    relevance = False\n    for keyword in keywords:\n      if keyword in title.lower() or keyword in description.lower():\n        relevance = True\n    data.append({\n      'title': title,\n      'description': description,\n      'url': url,\n      'date': date,\n      'relevance': relevance,\n      'source_id': _('URL Tracking').first().json.id\n    })\n\nreturn data"
