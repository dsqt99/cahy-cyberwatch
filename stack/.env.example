# CAHY CyberWatch - local n8n + PostgreSQL stack
# Copy to .env (same folder as docker-compose.local.yml). docker compose reads it
# for ${...} substitution, and the n8n container loads it via env_file.

# --- PostgreSQL ---
# Host/port as seen from inside the docker network (used by n8n workflows)
POSTGRES_HOST=n8n_postgres
POSTGRES_PORT=5432
# Host port published on this machine (5433 is often taken by another local Postgres)
POSTGRES_EXTERNAL_PORT=5435
# App database created by postgres-api from postgres/init-cahy-db.sql
POSTGRES_DB=cahy_cyberwatch
# Superuser for the postgres container. Changing these after the volume exists
# does not change the stored password; recreate the volume or ALTER USER instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# postgres-api REST service, as seen from inside the docker network
POSTGRES_API_URL=http://postgres_api:5434

# HMAC secret for postgres-api login tokens. Empty = built-in fallback (dev only).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=

# --- LLM (OpenAI-compatible endpoint) used by the analysis workflows ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Serper web search ---
SERPER_API_KEY=

# --- FoxProfile (runs on the host, started by the Electron app) ---
FOXPROFILE_API_URL=http://host.docker.internal:8010
# Must match foxprofileToken in ../config.json (leave both empty to disable auth on 127.0.0.1)
FOXPROFILE_API_TOKEN=
# Path inside the n8n container; the host side is SCREENSHOT_HOST_DIR below
FOXPROFILE_SCREENSHOT_DIR=/screenshots

# Host folder mounted at /screenshots. Relative to this folder; must match
# screenshotDir in ../config.json.
SCREENSHOT_HOST_DIR=../screenshots
