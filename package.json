{
  "name": "cahy-cyberwatch",
  "version": "2.0.0",
  "private": true,
  "description": "CAHY CyberWatch - Hệ thống Giám sát & Điều hành Không gian mạng All-in-One (Dashboard + n8n Control + FoxProfile Antidetect + Webhook Engine)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node src/cli/start.js",
    "restart": "node src/cli/start.js --restart",
    "start:raw": "electron .",
    "agent": "node src/cli/agent.js",
    "smoke": "electron . --smoke-test",
    "test": "node --test",
    "dist": "npm run build:dashboard && electron-builder --win portable",
    "build:dashboard": "npm --prefix dashboard run build",
    "setup": "npm install && npm --prefix dashboard install && npm run build:dashboard && npm run setup:fox",
    "setup:fox": "cd foxprofile && python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt"
  },
  "build": {
    "appId": "vn.cahy.cyberwatch",
    "productName": "CAHY CyberWatch",
    "files": [
      "src/**/*",
      "preload/**/*",
      "shell/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "dashboard/dist",
        "to": "dashboard"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
